{
  "name": "dots-and-boxes-backend",
  "scripts": {
    "dev": "ts-node-dev --files -r dotenv/config -r tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm migration:generate -d src/database.ts",
    "migration:create": "npm run typeorm migration:create",
    "migration:run": "npm run typeorm migration:run -d src/database.ts",
    "migration:revert": "npm run typeorm migration:revert -d src/database.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.2.0",
    "@types/socket.io": "^3.0.1",
    "bcrypt": "^6.0.0",
    "class-validator": "^0.15.1",
    "dotenv": "^17.3.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.19.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "typeorm": "^1.1.1",
    "typeorm-naming-strategy": "^3.0.0",
    "ws": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.3.2",
    "@types/pg": "^8.16.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  }
}
