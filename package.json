{
  "name": "dots-n-boxes",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev:backend": "cd dots-n-boxes-backend && npm run dev",
    "dev:frontend": "cd dots-n-boxes-frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd dots-n-boxes-backend && npm run build",
    "build:frontend": "cd dots-n-boxes-frontend && npm run build",
    "start": "concurrently \"npm run start:backend\" \"npm run preview:frontend\"",
    "start:backend": "cd dots-n-boxes-backend && npm run start",
    "preview:frontend": "cd dots-n-boxes-frontend && npm run preview",
    "install:all": "npm install && cd dots-n-boxes-backend && npm install && cd ../dots-n-boxes-frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}